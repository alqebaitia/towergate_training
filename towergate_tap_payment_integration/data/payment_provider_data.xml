<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="payment_provider_tap" model="payment.provider">
        <field name="name">Tap</field>
        <field name="code">tap</field>
        <field name="sequence">10</field>
        <field name="redirect_form_view_id" ref="payment.generic_redirect_form"/>
        <field name="image_128" type="bytes" file="towergate_tap_payment_integration/static/img/tap.png"/>
        <field name="allow_tokenization">False</field>
        <field name="allow_express_checkout">False</field>
        <field name="is_published">True</field>
        <field
            name="payment_method_ids"
            eval="[Command.set([ref('towergate_tap_payment_integration.payment_method_tap')])]"
        />
    </record>

</odoo>
